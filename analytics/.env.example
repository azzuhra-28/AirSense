# ============================================================
# .env.example - Salin jadi .env lalu isi kunci kamu
# ============================================================

# Supabase project URL (tanpa trailing slash)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase KEY
# - Untuk development lokal: publishable key (sb_publishable_...)
# - Untuk production/deploy: SERVICE ROLE key (sb_secret_...) dari
#   Settings > API > Secret keys (JANGAN pernah di-share / dipakai frontend!)
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ============================================================
# Notifikasi Telegram (opsional)
# ============================================================
# 1. Buat bot lewat @BotFather, salin token-nya.
# 2. Kirim satu pesan ke bot, lalu buka:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    dan salin angka "chat":{"id": ...}.
# Kosongkan kalau tidak dipakai; scheduler tetap jalan tanpa notifikasi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=