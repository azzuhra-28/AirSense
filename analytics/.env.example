# ============================================================
# .env.example - Salin jadi .env lalu isi kunci kamu
# ============================================================

# Supabase project URL (tanpa trailing slash)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase KEY
# - Untuk development lokal: publishable key (sb_publishable_...)
# - Untuk production/deploy: SERVICE ROLE key (sb_secret_...) dari
#   Settings > API > Secret keys (JANGAN pernah di-share / dipakai frontend!)
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx